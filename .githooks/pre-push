#!/usr/bin/env bash
# Compile the Rust shell on Linux before letting a push go out.
#
# The desktop app is developed on Windows. macOS and Linux were only ever
# compiled by CI, and Actions stopped running on 2026-09-11, so a Linux-only
# break now reaches a release tag before anyone finds out. This closes two
# thirds of that gap. The macOS third stays open until there is a Mac.
#
# Enabled by pointing git at this directory, which is a tracked one so the hook
# survives a fresh clone:
#
#   git config core.hooksPath .githooks
#
# To push anyway, the standard escape hatch works:
#
#   git push --no-verify

set -uo pipefail

ZERO=0000000000000000000000000000000000000000

# Nothing under here can affect whether the Rust shell compiles. site/ is the
# marketing pages, tools/ is shell and python, rings/ is generated meshes. Only
# desktop/ and index.html feed the build: index.html because build.mjs copies
# it into dist/ and tauri-build reads it while compiling.
touches_build() {
  grep -qE '^(desktop/|index\.html$|\.githooks/)' <<<"$1"
}

ran=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                  # a branch deletion
  case "$local_ref" in refs/heads/*) ;; *) continue ;; esac  # tags are not branches
  branch=${local_ref#refs/heads/}

  if [ "$remote_sha" = "$ZERO" ]; then
    # A branch the remote has never seen. There is no sensible base to diff
    # against, so do not try to be clever about it.
    changed=""
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || changed=""
    if [ -n "$changed" ] && ! touches_build "$changed"; then
      printf '\033[2m  pre-push: nothing under desktop/ in %s, skipping the Linux check\033[0m\n' "$branch"
      continue
    fi
  fi

  if ! command -v wsl.exe >/dev/null 2>&1; then
    # Refusing every push because the checker is unavailable is worse than the
    # gap it covers, but saying nothing recreates exactly the silence this
    # exists to end.
    printf '\n\033[1;33m!! pre-push: wsl.exe not found, the Linux check did NOT run\033[0m\n'
    printf '\033[1;33m!! Pushing anyway. %s has not been compiled for Linux.\033[0m\n\n' "$branch"
    continue
  fi

  ran=1
  tools/check-linux.sh "$branch"
  case $? in
    0) ;;
    # 2 is the check failing to run at all: no clone, no fetch, drive not
    # mounted. Reporting that as "does not compile" sends someone into the
    # code after a bug that is not there, which is what happened the first
    # time this hook ran for real.
    2) printf '\n\033[1;33m!! The Linux check could not run, so %s was NOT checked\033[0m\n' "$branch"
       printf '\033[1;33m!! Pushing anyway. See the error above.\033[0m\n\n'
       ;;
    *) printf '\n\033[1;31m!! %s does not compile on Linux, push refused\033[0m\n' "$branch"
       printf '\033[1;31m!! Fix it, or push anyway with: git push --no-verify\033[0m\n\n'
       exit 1
       ;;
  esac
done

[ "$ran" = 1 ] && printf '\033[2m  pre-push: Linux build is good\033[0m\n'
exit 0
